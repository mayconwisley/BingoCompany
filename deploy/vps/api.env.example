ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5138
BingoJwtKey=replace-with-a-random-32-byte-or-longer-secret
Authentication__CookiePath=/bingo
Authentication__CookieName=__Secure-bingo-company-auth
Cors__AllowedOrigins__0=https://mcnwly.com.br
Cors__AllowedOrigins__1=https://www.mcnwly.com.br
AllowedHosts=mcnwly.com.br;www.mcnwly.com.br
DBBingoUser=bingo
DBBingoPass=replace-with-the-postgresql-password
ConnectionStrings__Bingo=Host=127.0.0.1;Port=6432;Database=bingo;Username={{username}};Password={{password}};Timeout=60;Maximum Pool Size=20
Database__DbContextPoolSize=32
Database__EnsureDatabaseExists=false
