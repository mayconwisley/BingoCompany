ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5138
BingoJwtKey=replace-with-a-random-32-byte-or-longer-secret
DBBingoUser=bingo
DBBingoPass=replace-with-the-postgresql-password
ConnectionStrings__Bingo=Host=127.0.0.1;Port=6432;Database=bingo;Username={{username}};Password={{password}};Timeout=60;Maximum Pool Size=200
Database__AdministrationDatabase=postgres
Database__AdministrationPort=6432
