{
    "name": "bingo-company-frontend",
    "private": false,
    "version": "1.2.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "eslint": "eslint src",
        "lint": "npm run eslint",
        "typecheck": "tsc -b",
        "typeformat": "prettier --check \"src/**/*.{ts,tsx}\"",
        "format": "prettier --write \"src/**/*.{ts,tsx}\"",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@microsoft/signalr": "^9.0.0",
        "@mui/material": "^9.2.0",
        "@types/qrcode": "^1.5.6",
        "@vitejs/plugin-react": "^4.3.4",
        "@zxing/browser": "^0.2.1",
        "qrcode": "^1.5.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.6.2",
        "vite": "^6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.0",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.5",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}