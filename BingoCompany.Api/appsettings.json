{
	"ConnectionStrings": {
		"Bingo": "Host=localhost;Port=6432;Database=bingo;Username={{username}};Password={{password}};Timeout=60;Maximum Pool Size=200"
	},
	"Database": {
		"DbContextPoolSize": 128,
		"EnsureDatabaseExists": true,
		"AdministrationDatabase": "postgres",
		"AdministrationPort": 5432
	},
	"Authentication": {
		"Issuer": "BingoCompany.Api",
		"Audience": "BingoCompany.Frontend",
		"TokenLifetimeMinutes": 120,
		"CookiePath": "/"
	},
	"Cors": {
		"AllowedOrigins": ["http://localhost:5173"]
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "localhost"
}
